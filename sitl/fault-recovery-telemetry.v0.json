{
  "version": "0.1.0",
  "feature_id": "FEAT-010",
  "scope": "Deterministic SITL-style fault recovery, resume-policy, duplicate-spray prevention, and black-box telemetry contract for cucumber-row AGV sprayer missions.",
  "sources": {
    "mission_export": "missions/cucumber-row-mission.v0.json",
    "actuator_mapping": "hardware/pixhawk-actuator-mapping.v0.json",
    "preflight_dosing": "sitl/preflight-dosing.v0.json",
    "position_confidence": "sitl/position-confidence.v0.json"
  },
  "units": {
    "timestamp_s": "seconds from scenario start",
    "hold_duration_s": "seconds",
    "clear_event_age_s": "seconds",
    "fault_clear_age_s": "seconds",
    "fallback_duration_s": "seconds",
    "fallback_distance_m": "meters",
    "pump_pwm_us": "microseconds",
    "spray_progress": "0.0 to 1.0 fraction of logical spray work unit"
  },
  "safe_outputs": {
    "pump_pwm_us": 1000,
    "left_spray_valve": 0,
    "right_spray_valve": 0,
    "agitation": 0
  },
  "spray_outputs": {
    "LEFT": {
      "pump_pwm_us": 1450,
      "left_spray_valve": 1,
      "right_spray_valve": 0,
      "agitation": 1
    },
    "OFF": {
      "pump_pwm_us": 1000,
      "left_spray_valve": 0,
      "right_spray_valve": 0,
      "agitation": 0
    }
  },
  "state_machine": {
    "states": {
      "MISSION_RUNNING": "Navigation, dosing, preflight, and position-confidence inputs are currently safe enough to continue the mission.",
      "HOLD_FAULT_ACTIVE": "A fault or unsafe confidence state requires HOLD mode with all sprayer outputs off.",
      "RECOVERY_READY": "Fault-clear telemetry is fresh, required acknowledgement is present, and position confidence is acceptable for resume.",
      "RECOVERY_BLOCKED": "A recovery attempt was rejected because policy inputs are stale, incomplete, unsafe, or would duplicate spraying.",
      "MISSION_RESUMED": "Mission execution restarted at the first unsprayed spray-ledger work unit or at the next non-spray mission item.",
      "MISSION_COMPLETE": "Mission ended with all required spray work units either sprayed once or intentionally skipped with documented reason.",
      "MISSION_ABORTED": "Mission cannot safely recover within policy and remains safe/off."
    },
    "allowed_transitions": [
      [
        "MISSION_RUNNING",
        "HOLD_FAULT_ACTIVE"
      ],
      [
        "MISSION_RUNNING",
        "MISSION_COMPLETE"
      ],
      [
        "HOLD_FAULT_ACTIVE",
        "RECOVERY_READY"
      ],
      [
        "HOLD_FAULT_ACTIVE",
        "RECOVERY_BLOCKED"
      ],
      [
        "HOLD_FAULT_ACTIVE",
        "MISSION_ABORTED"
      ],
      [
        "RECOVERY_READY",
        "MISSION_RESUMED"
      ],
      [
        "RECOVERY_BLOCKED",
        "HOLD_FAULT_ACTIVE"
      ],
      [
        "MISSION_RESUMED",
        "MISSION_RUNNING"
      ],
      [
        "MISSION_RUNNING",
        "MISSION_ABORTED"
      ]
    ]
  },
  "recovery_policy": {
    "recoverable_fault_types": [
      "FRONT_OBSTACLE",
      "CANOPY_RTK_DROP",
      "ULTRASONIC_CANOPY_SHADOW"
    ],
    "unrecoverable_fault_types": [
      "ESTOP_ACTIVE",
      "LOW_LIQUID",
      "ODOMETER_IMU_DIVERGENCE",
      "PUMP_FEEDBACK_MISMATCH"
    ],
    "fault_classes": {
      "FRONT_OBSTACLE": {
        "recoverability": "recoverable_after_clear",
        "requires_hold_on_detection": true,
        "requires_operator_ack": true,
        "allowed_resume_position_confidence_states": [
          "RTK_CONFIDENT",
          "DEAD_RECKONING_ACTIVE"
        ]
      },
      "CANOPY_RTK_DROP": {
        "recoverability": "bounded_position_recovery",
        "requires_hold_on_detection": false,
        "requires_operator_ack": false,
        "allowed_continue_position_confidence_states": [
          "DEAD_RECKONING_ACTIVE"
        ],
        "fallback_budget_ref": "sitl/position-confidence.v0.json thresholds max_fallback_duration_s and max_fallback_distance_m"
      },
      "ULTRASONIC_CANOPY_SHADOW": {
        "recoverability": "recoverable_after_clear",
        "requires_hold_on_detection": true,
        "requires_operator_ack": true,
        "allowed_resume_position_confidence_states": [
          "RTK_CONFIDENT"
        ]
      },
      "ESTOP_ACTIVE": {
        "recoverability": "unrecoverable_for_auto_resume",
        "requires_hold_on_detection": true,
        "requires_operator_ack": true,
        "auto_resume_allowed": false
      },
      "LOW_LIQUID": {
        "recoverability": "unrecoverable_for_auto_resume",
        "requires_hold_on_detection": true,
        "requires_operator_ack": true,
        "auto_resume_allowed": false
      },
      "ODOMETER_IMU_DIVERGENCE": {
        "recoverability": "unrecoverable_for_auto_resume",
        "requires_hold_on_detection": true,
        "requires_operator_ack": true,
        "auto_resume_allowed": false
      },
      "PUMP_FEEDBACK_MISMATCH": {
        "recoverability": "unrecoverable_for_auto_resume",
        "requires_hold_on_detection": true,
        "requires_operator_ack": true,
        "auto_resume_allowed": false
      }
    },
    "max_fault_clear_age_s": 2.0,
    "max_hold_duration_s": 15.0,
    "max_actuator_safe_latency_ms": 200,
    "allowed_resume_position_confidence_states": [
      "RTK_CONFIDENT",
      "DEAD_RECKONING_ACTIVE"
    ],
    "resume_start_policy": "FIRST_UNSPRAYED_LEDGER_UNIT",
    "duplicate_spray_action": "SUPPRESS_COMMAND_LOG_EVENT_KEEP_OUTPUTS_SAFE",
    "stale_clear_action": "BLOCK_RESUME_KEEP_HOLD",
    "missing_ack_action": "BLOCK_RESUME_KEEP_HOLD"
  },
  "spray_ledger": {
    "identity_fields": [
      "mission_id",
      "spray_unit_id",
      "row_label",
      "spray_zone",
      "pass_id"
    ],
    "completion_statuses": [
      "unsprayed",
      "sprayed",
      "skipped_duplicate_suppressed"
    ],
    "resume_scan_order": [
      "row_01_left_spray_head",
      "row_01_left_spray_tail"
    ],
    "spray_work_units": [
      {
        "spray_unit_id": "row_01_left_spray_head",
        "mission_id": "cucumber_row_synthetic_mission_v0",
        "mission_segment_id": "row_01_left_spray",
        "mission_item_start": "WP003",
        "mission_item_end": "WP004",
        "row_label": "row_01_left_spray_start",
        "spray_zone": "LEFT",
        "pass_id": "pass_001",
        "progress_range": {
          "start": 0.0,
          "end": 0.45
        }
      },
      {
        "spray_unit_id": "row_01_left_spray_tail",
        "mission_id": "cucumber_row_synthetic_mission_v0",
        "mission_segment_id": "row_01_left_spray",
        "mission_item_start": "WP003",
        "mission_item_end": "WP004",
        "row_label": "row_01_left_spray_end",
        "spray_zone": "LEFT",
        "pass_id": "pass_001",
        "progress_range": {
          "start": 0.45,
          "end": 1.0
        }
      }
    ]
  },
  "telemetry_schema": {
    "sequence_policy": "Telemetry sequence numbers must be strictly increasing and timestamps must be nondecreasing within each scenario.",
    "common_required_fields": [
      "seq",
      "timestamp_s",
      "event_type",
      "state",
      "mode",
      "mission_item_id",
      "actuator_state"
    ],
    "required_event_types_by_expected_outcome": {
      "MISSION_COMPLETE_AFTER_RECOVERY": [
        "MISSION_START",
        "SPRAY_ON",
        "FAULT_DETECTED",
        "HOLD_ENTERED",
        "ACTUATORS_SAFE",
        "FAULT_CLEAR",
        "RESUME_ACK",
        "POSITION_CONFIDENCE",
        "RECOVERY_DECISION",
        "MISSION_RESUMED",
        "SPRAY_LEDGER_RECORD",
        "SPRAY_OFF",
        "MISSION_COMPLETE"
      ],
      "BOUNDED_DEAD_RECKONING_COMPLETE": [
        "MISSION_START",
        "SPRAY_ON",
        "SENSOR_DEGRADED",
        "POSITION_CONFIDENCE",
        "RECOVERY_DECISION",
        "SPRAY_LEDGER_RECORD",
        "SPRAY_OFF",
        "MISSION_COMPLETE"
      ],
      "DUPLICATE_SUPPRESSED_COMPLETE": [
        "MISSION_RESUMED",
        "SPRAY_REPLAY_ATTEMPT",
        "DUPLICATE_SPRAY_SUPPRESSED",
        "MISSION_COMPLETE"
      ],
      "MISSION_ABORTED": [
        "MISSION_START",
        "FAULT_DETECTED",
        "HOLD_ENTERED",
        "ACTUATORS_SAFE",
        "HOLD_TIMEOUT",
        "MISSION_ABORTED"
      ],
      "RESUME_BLOCKED": [
        "MISSION_START",
        "FAULT_DETECTED",
        "HOLD_ENTERED",
        "ACTUATORS_SAFE",
        "FAULT_CLEAR",
        "POSITION_CONFIDENCE",
        "RECOVERY_DECISION"
      ]
    },
    "required_fields_by_event_type": {
      "MISSION_START": [
        "mission_id"
      ],
      "SPRAY_ON": [
        "spray_unit_id",
        "spray_zone"
      ],
      "SPRAY_LEDGER_RECORD": [
        "spray_unit_id",
        "ledger_status"
      ],
      "SPRAY_OFF": [
        "spray_unit_id"
      ],
      "FAULT_DETECTED": [
        "fault_id",
        "fault_type",
        "recovery_class",
        "position_confidence_state"
      ],
      "SENSOR_DEGRADED": [
        "fault_id",
        "fault_type",
        "position_confidence_state"
      ],
      "HOLD_ENTERED": [
        "fault_id",
        "reason_codes"
      ],
      "ACTUATORS_SAFE": [
        "fault_id",
        "safe_output_verified"
      ],
      "FAULT_CLEAR": [
        "fault_id",
        "clear_event_age_s",
        "clear_source"
      ],
      "RESUME_ACK": [
        "fault_id",
        "ack_source",
        "acknowledgement"
      ],
      "POSITION_CONFIDENCE": [
        "position_confidence_state",
        "confidence_inputs"
      ],
      "RECOVERY_DECISION": [
        "fault_id",
        "recovery_decision",
        "resume_allowed",
        "reason_codes"
      ],
      "MISSION_RESUMED": [
        "resume_policy",
        "resume_unit_id"
      ],
      "SPRAY_REPLAY_ATTEMPT": [
        "spray_unit_id",
        "requested_actuator_state"
      ],
      "DUPLICATE_SPRAY_SUPPRESSED": [
        "spray_unit_id",
        "reason_codes"
      ],
      "HOLD_TIMEOUT": [
        "fault_id",
        "hold_duration_s",
        "reason_codes"
      ],
      "MISSION_ABORTED": [
        "fault_id",
        "reason_codes"
      ],
      "MISSION_COMPLETE": [
        "outcome"
      ]
    }
  },
